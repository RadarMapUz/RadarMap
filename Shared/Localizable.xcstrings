        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "30 kunlik safarlarning o‘rtacha bali. Uzoq safarlar qisqalaridan ko‘proq vazn oladi."
          }
        }
      }
    },
    "Стали ездить чище: %1$@ превышения на 100 км против %2$@ в прошлый период": {
