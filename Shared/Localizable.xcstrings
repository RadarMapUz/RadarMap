    "%@: есть газ, очередь? Ответ увидят водители рядом.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: есть газ, очередь? Ответ увидят водители рядом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: gaz bormi, navbat bormi? Javobni yaqindagi haydovchilar koʻradi."
          }
        }
      }
