          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatolar, g‘oyalar, noaniq kameralar — har bir xabarni o‘qib, bazani to‘g‘rilaymiz."
          }
        }
      }
    },
    "Первая появится здесь сразу после того, как вы доедете.": {
      "extractionState": "manual",
      "localizations": {
