        }
      }
    },
    "Вклад = недобор балла до 100 × доля пути: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклад = недобор балла до 100 × доля пути: %@"
          }
