          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Safar oʻzi yoqildi. Yoʻlovchimisiz? Bosing — quvvatni tejaymiz."
          }
        }
      }
    },
    "Поездка идёт": {
      "localizations": {
