        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joylashuv aniqlanmoqda: reestrdagi manzilni yoʻlga bogʻlab boʻlmadi. Bunday kamera haqida zaxira bilan ogohlantiramiz."
          }
