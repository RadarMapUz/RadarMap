    "Укажите расход и цену — и в поездках, «Итогах» и «Дороге на работу» появится стоимость.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите расход и цену — и в поездках, «Итогах» и «Дороге на работу» появится стоимость."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarf va narxni kiriting — safarlarda, «Natijalar»da va «Ishga yoʻl»da narx paydo boʻladi."
          }
        }
      }
    },
    "Укажите расход и цену — стоимость появится в поездках и «Итогах». Там же — проверка штрафов по госномеру.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите расход и цену — стоимость появится в поездках и «Итогах». Там же — проверка штрафов по госномеру."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarf va narxni kiriting — narx safarlarda va «Natijalar»da paydo boʻladi. Oʻsha yerda — davlat raqami boʻyicha jarimalarni tekshirish."
          }
        }
      }
    },
