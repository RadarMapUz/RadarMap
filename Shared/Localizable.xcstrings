    "Геолокация выключена. Включите «Всегда» для оповещений о камерах.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокация выключена. Включите «Всегда» для оповещений о камерах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Geolokatsiya oʻchirilgan. Kamera ogohlantirishlari uchun «Doim»ni yoqing."
          }
        }
      }
    },
    "Говорит о каждой камере: в городе коротко, на трассе полной фразой.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит о каждой камере: в городе коротко, на трассе полной фразой."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir kamera haqida aytadi: shaharda qisqa, trassada toʻliq jumla bilan."
          }
        }
      }
    },
    "Говорит только по делу": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит только по делу"
          }
        },
        "uz": {
