      }
    },
    "В сохранённых поездках периода нет проездов с риском штрафа": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сохранённых поездках периода нет проездов с риском штрафа"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Davrning saqlangan safarlarida jarima xavfi bo'lgan o'tishlar yo'q"
          }
        }
      }
    },
    "В этом периоде нет поездок с превышениями — это хорошая новость.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом периоде нет поездок с превышениями — это хорошая новость."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davrda tezlik oshirilgan safarlar yo'q — bu yaxshi xabar."
          }
        }
      }
    },
    "В этом периоде поездок не было": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом периоде поездок не было"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davrda safarlar bo'lmagan"
          }
        }
      }
    },
    "Варианты маршрута": {
      "localizations": {
        "ru": {
