      }
    },
    "История, рейтинг и итоги за все периоды сотрутся с телефона. Вернуть их будет нельзя.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История, рейтинг и итоги за все периоды сотрутся с телефона. Вернуть их будет нельзя."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha davrlar uchun tarix, reyting va natijalar telefondan o‘chib ketadi. Ularni qaytarib bo‘lmaydi."
          }
        }
      }
    },
    "Нет связи": {
      "localizations": {
