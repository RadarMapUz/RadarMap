            "state": "translated",
            "value": "Doim"
          }
        }
      }
    },
    "Всегда короткие фразы: камеры идут одна за другой.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда короткие фразы: камеры идут одна за другой."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Doim qisqa iboralar: kameralar ketma-ket keladi."
          }
        }
      }
    },
    "Всегда полные фразы и заранее: камер мало, ехать до следующей далеко.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда полные фразы и заранее: камер мало, ехать до следующей далеко."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Doim to‘liq iboralar va oldindan: kameralar kam, keyingisiga uzoq."
          }
        }
      }
    },
    "Всего: %lld": {
      "localizations": {
