    "Камеры видеофиксации Узбекистана — предупредим заранее, даже когда телефон в кармане.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камеры видеофиксации Узбекистана — предупредим заранее, даже когда телефон в кармане."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O'zbekiston foto-video qayd kameralari — telefon cho'ntakda bo'lsa ham oldindan ogohlantiramiz."
          }
        }
      }
    },
