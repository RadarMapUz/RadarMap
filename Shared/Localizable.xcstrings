    },
    "Слишком часто, подождите минуту": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком часто, подождите минуту"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Juda tez-tez, bir daqiqa kuting"
