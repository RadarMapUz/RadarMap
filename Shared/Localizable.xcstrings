      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос о камерах — короткий, если режим оповещений «Авто»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameralar haqidagi ovoz — qisqa, agar ogohlantirish rejimi «Avto» boʻlsa."
