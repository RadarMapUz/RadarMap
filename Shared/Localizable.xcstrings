          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarima haqidagi SMS yoki bildirishnoma matnini shu yerga qoʻying"
          }
        }
      }
    },
    "Вставьте текст СМС — сверим с поездкой": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте текст СМС — сверим с поездкой"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS matnini qoʻying — safar bilan solishtiramiz"
          }
        }
      }
    },
    "Встроенная база камер не читается — переустановите приложение.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенная база камер не читается — переустановите приложение."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichki kameralar bazasi oʻqilmayapti — ilovani qayta oʻrnating."
          }
        }
      }
    },
    "Всё время": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё время"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Butun vaqt"
          }
        }
      }
    },
    "Всё до этой остановки станет одной поездкой, всё после — другой.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё до этой остановки станет одной поездкой, всё после — другой."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu toʻxtashgacha boʻlgani bitta safar boʻladi, keyingisi — boshqa safar."
          }
        }
      }
    },
