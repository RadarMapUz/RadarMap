# Xcode — любые локальные каталоги сборки (build, build_device, build_sim, build_watch…)
build*/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/

# Секреты — никогда не коммитим
*.env
*.pem
*.mobileprovision

# Python-кэш серверных скриптов: собирается при каждом запуске тестов
__pycache__/
*.pyc

# Выход прогона снапа (snap_cameras.sh, registry_diff) — для просмотра на месте,
# не для репозитория: копии устаревали (август, v6), план 11.12.
server/snap/
