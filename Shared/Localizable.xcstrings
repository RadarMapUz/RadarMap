          "stringUnit": {
            "state": "translated",
            "value": "Предупреждаем о камерах, даже когда телефон в кармане, а приложение свёрнуто."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon choʻntakda, ilova yigʻilgan boʻlsa ham kameralar haqida ogohlantiramiz."
          }
        }
      }
    },
