        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarita serveri javob bermayapti — xarita yuklab olingan hududdan"
          }
        }
      }
    },
    "Сервер не отвечает — отправлю, как только ответит.": {
      "localizations": {
