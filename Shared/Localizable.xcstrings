          "stringUnit": {
            "state": "translated",
            "value": "Yana %lld ta safar — va «odatda» paydo boʻladi"
          }
        }
      }
    },
    "Обычно %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно %@"
          }
        },
