      }
    },
    "Все камеры и радары Узбекистана из официальных данных. База обновляется сама.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все камеры и радары Узбекистана из официальных данных. База обновляется сама."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zbekistonning barcha kamera va radarlari rasmiy ma’lumotlardan. Baza o‘zi yangilanadi."
          }
        }
      }
    },
    "Все поездки": {
