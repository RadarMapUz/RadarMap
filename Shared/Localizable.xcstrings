            "value": "Реальный запас — %@: вы указали сами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haqiqiy zaxira — %@: oʻzingiz kiritgansiz."
          }
        }
      }
    },
    "Реальный запас: %1$@ по %2$@ × %3$@ ≈ %4$@ в городе.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реальный запас: %1$@ по %2$@ × %3$@ ≈ %4$@ в городе."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haqiqiy zaxira: %2$@ boʻyicha %1$@ × %3$@ ≈ shaharda %4$@."
          }
        }
      }
    },
    "Реальный запас: %1$@ → %2$@": {
      "localizations": {
