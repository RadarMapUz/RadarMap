            "value": "Barcha viloyatlar"
          }
        }
      }
    },
    "Занято на телефоне: %@. Вся страна — %@. Лучше качать по Wi-Fi.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занято на телефоне: %@. Вся страна — %@. Лучше качать по Wi-Fi."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonda band: %@. Butun mamlakat — %@. Wi-Fi orqali yuklash yaxshiroq."
          }
        }
      }
    },
