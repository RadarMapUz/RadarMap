          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoʻlning bir qismi hali maʼlumotsiz — %@. Wi-Fi orqali yuklanadi."
          }
        }
      }
    },
    "Чаще всего — %1$@: превышений %2$lld из %3$lld": {
