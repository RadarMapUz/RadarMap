[Unit]
Description=RadarMap mobile-camera crowdsourcing API (127.0.0.1:8091)
After=network.target

[Service]
Environment=RADARMAP_ADMIN_URL=https://soulmed.uz/radarmap/admin
ExecStart=/usr/bin/python3 /opt/radarmap/api/api.py
Restart=always
RestartSec=3
User=root
WorkingDirectory=/opt/radarmap/api

[Install]
WantedBy=multi-user.target
