    },
    "Отмечает передвижной радар в текущей точке — другие водители увидят его на карте.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечает передвижной радар в текущей точке — другие водители увидят его на карте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joriy nuqtada ko'chma radarni belgilaydi — boshqa haydovchilar uni xaritada ko'radi."
          }
        }
      }
    },
    "Отмечали %lld раз, в разные дни: %lld": {
      "localizations": {
