          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Geolokatsiya o'chirilgan. Kamera ogohlantirishlari uchun «Doim»ni yoqing."
          }
        }
      }
    },
    "Говорит о каждой камере: в городе коротко, на трассе полной фразой.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит о каждой камере: в городе коротко, на трассе полной фразой."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir kamera haqida aytadi: shaharda qisqa, trassada to'liq jumla bilan."
          }
        }
      }
    },
    "Говорю только по делу": {
