{
  "sourceLanguage" : "ru",
  "strings" : {
    "CameraAlerts" : {
      "comment" : "Временная точная геопозиция (requestTemporaryFullAccuracyAuthorization purposeKey: CameraAlerts)",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная геопозиция нужна, чтобы вовремя предупреждать о камерах именно на вашей дороге."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynan siz yurgan yoʻldagi kameralar haqida oʻz vaqtida ogohlantirish uchun aniq geojoylashuv kerak."
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RadarMap"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RadarMap"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RadarMap"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RadarMap"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Запрос гео «Всегда» — фоновые оповещения о камерах",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы предупреждать о камерах голосом, когда приложение свёрнуто или экран погашен. На сервер уходят запрос маршрута, ваши отметки и «Поделиться прибытием», а в поездке — обезличенные отрезки для пробок; их можно выключить в настройках."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilova yigʻilgan yoki ekran oʻchiq boʻlsa ham kameralar haqida ovozli ogohlantirish uchun. Serverga marshrut soʻrovi, belgilaringiz va «Yetib borish vaqtini ulashish», safar paytida esa tirbandlik uchun shaxssiz yoʻl boʻlaklari yuboriladi; ularni sozlamalarda oʻchirish mumkin."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Запрос гео «При использовании» — карта камер и оповещения",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RadarMap показывает камеры видеофиксации на карте рядом с вами и определяет ваше положение, чтобы предупреждать о ближайших камерах."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RadarMap yaqin atrofdagi video qayd kameralarini xaritada koʻrsatadi va eng yaqin kameralar haqida ogohlantirish uchun joylashuvingizni aniqlaydi."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Датчик движения — автостарт/стоп поездки",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RadarMap определяет начало и конец поездки, чтобы автоматически включать оповещения за рулём и не тратить заряд, когда вы не едете."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RadarMap safar boshlanishi va tugashini aniqlaydi — bu haydash paytida ogohlantirishlarni avtomatik yoqish va yurmaganda quvvatni tejash uchun."
          }
        }
      }
    }
  },
  "version" : "1.0"
}