          }
        }
      }
    },
    "Цены не обновлялись больше двух месяцев — проверьте, не изменились ли.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены не обновлялись больше двух месяцев — проверьте, не изменились ли."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narxlar ikki oydan beri yangilanmagan — oʻzgarmaganini tekshiring."
          }
        }
      }
    },
    "Чаще всего — %1$@: превышений %2$lld из %3$lld": {
      "localizations": {
        "ru": {
