            "value": "Длиннее реального запаса — нужна зарядка в пути"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haqiqiy zaxiradan uzun — yoʻlda quvvatlash kerak"
          }
        }
