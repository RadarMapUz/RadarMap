          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizning odatiy darajangiz — odatda %1$lld va %2$lld orasida boʻlasiz."
          }
        }
      }
    },
    "Это не копия RadarMap или она из более новой версии": {
      "extractionState": "manual",
      "localizations": {
