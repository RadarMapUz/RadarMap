    "Рискуете чаще: %1$@ превышения на 100 км против %2$@ в прошлый период" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рискуете чаще: %1$@ превышения на 100 км против %2$@ в прошлый период"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tez-tez xavf qilyapsiz: har 100 km ga %1$@ ta oshirish, o'tgan davrda %2$@ edi"
          }
        }
      }
    },
    "С %1$02d до %2$02d часов: превышений %3$lld" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
