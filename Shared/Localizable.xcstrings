            "value": "Чаще всего: %@ — показать"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eng ko‘p: %@ — ko‘rsatish"
          }
        }
      }
    },
    "Через %lld метров — %@": {
