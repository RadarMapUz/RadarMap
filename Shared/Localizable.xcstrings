          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Kelmadi» belgisini faqat saqlangan safarlarga qo'yish mumkin — tarixda oxirgi 50 tasi saqlanadi."
          }
        }
      }
    },
