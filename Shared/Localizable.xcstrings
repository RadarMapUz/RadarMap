            "state": "translated",
            "value": "Vibro"
          }
        }
      }
    },
    "Виджет: сколько ехать сейчас и не мешают ли пробки — ещё до выезда.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет: сколько ехать сейчас и не мешают ли пробки — ещё до выезда."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidjet: hozir qancha yurish kerak va tirbandlik xalaqit bermaydimi — yoʻlga chiqishdan oldin."
          }
        }
      }
    },
    "Видят: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видят: %@"
          }
        },
        "uz": {
