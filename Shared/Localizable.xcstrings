            "value": "Bugun"
          }
        }
      }
    },
    "Сегодня — никому, с завтрашнего дня — как обычно.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня — никому, с завтрашнего дня — как обычно."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun — hech kimga, ertadan — odatdagidek."
          }
        }
      }
    },
    "Сегодняшняя дата. Введите пробег на странице — и срок посчитается и по километрам.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя дата. Введите пробег на странице — и срок посчитается и по километрам."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugungi sana. Sahifada probegni kiriting — muddat kilometr boʻyicha ham hisoblanadi."
          }
        }
      }
    },
