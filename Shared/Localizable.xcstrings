          }
        }
      }
    },
    "Проверка газового баллона": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка газового баллона"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaz ballon tekshiruvi"
          }
        }
      }
    },
    "Проверьте звук — кнопка с динамиком на карте. О камерах, которые вы часто проезжаете без превышения, приложение молчит намеренно: на карте у них зелёная галочка (Настройки → Приложение учится). Скрытую камеру можно вернуть в Настройках → О приложении → База камер → Скрытые камеры. Если ничего не подошло — нажмите «Не предупредила о камере» у этого проезда в Итогах, мы разберём случай.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте звук — кнопка с динамиком на карте. О камерах, которые вы часто проезжаете без превышения, приложение молчит намеренно: на карте у них зелёная галочка (Настройки → Приложение учится). Скрытую камеру можно вернуть в Настройках → О приложении → База камер → Скрытые камеры. Если ничего не подошло — нажмите «Не предупредила о камере» у этого проезда в Итогах, мы разберём случай."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovozni tekshiring — xaritadagi karnay tugmasi. Tez-tez tezlikni oshirmay oʻtadigan kameralaringiz haqida ilova ataylab jim turadi: xaritada ularda yashil belgi bor (Sozlamalar → Ilova oʻrganadi). Yashirilgan kamerani Sozlamalar → Ilova haqida → Kameralar bazasi → Yashirilgan kameralar boʻlimida qaytarish mumkin. Hech biri toʻgʻri kelmasa — Natijalardagi shu oʻtish yonidagi «Kamera haqida ogohlantirmadi» tugmasini bosing, holatni koʻrib chiqamiz."
          }
        }
      }
    },
    "Проверьте связь и попробуйте ещё раз.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте связь и попробуйте ещё раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloqani tekshiring va qaytadan urinib koʻring."
          }
        }
      }
    },
    "Проверьте: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте: %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekshiring: %@"
          }
        }
      }
    },
    "Прогноз прибытия ошибался в среднем на %lld мин": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз прибытия ошибался в среднем на %lld мин"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetib borish prognozi oʻrtacha %lld daq xato qildi"
          }
        }
      }
    },
    "Прогноз прибытия точен до минуты": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз прибытия точен до минуты"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetib borish prognozi bir daqiqagacha aniq"
          }
        }
      }
    },
    "Продлевать на, мес.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевать на, мес."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaytirish muddati, oy"
          }
        }
      }
    },
    "Продлено сегодня": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлено сегодня"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun uzaytirildi"
          }
        }
      }
    },
    "Прогноз — Open-Meteo, обновляется раз в полчаса. Где вы находитесь, сервер не узнаёт: телефон скачивает погоду по всем точкам и решает сам.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз — Open-Meteo, обновляется раз в полчаса. Где вы находитесь, сервер не узнаёт: телефон скачивает погоду по всем точкам и решает сам."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognoz — Open-Meteo, har yarim soatda yangilanadi. Server qayerdaligingizni bilmaydi: telefon barcha nuqtalar boʻyicha ob-havoni yuklab oladi va oʻzi hal qiladi."
          }
        }
      }
    },
    "Продолжить": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Davom etish"
          }
        }
      }
    },
    "Проезд %1$@ · %2$lld км/ч": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проезд %1$@ · %2$lld км/ч"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻtish %1$@ · %2$lld km/soat"
          }
        }
      }
    },
    "Проезд %1$@ · %2$lld км/ч при %3$lld": {
