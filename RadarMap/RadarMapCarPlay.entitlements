<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Используется ТОЛЬКО для сборок под симулятор (CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]):
	     симулятор не сверяет entitlement с профилем, и CarPlay-иконка появляется.
	     Для устройства нужен грант Apple (заявка: developer.apple.com/contact/carplay,
	     категория Navigation) — после гранта перенести ключ в RadarMap.entitlements. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
	<!-- App Group нужна и здесь: иначе в симуляторе SharedDefaults молчит и
	     домашний виджет нечем проверить — на устройстве он бы работал, а на
	     симуляторе показывал заглушку, и это выглядело бы багом виджета. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uz.radarmap.ios</string>
	</array>
	<!-- iCloud (27.F): приватная база CloudKit человека для своих поездок и
	     хранилище настроек. 👤 Владелец: Xcode → Signing & Capabilities → iCloud →
	     CloudKit + Key-value storage, контейнер iCloud.uz.radarmap.ios (тот же id —
	     AppConfig.cloudContainerID; тест сверяет). Без выданного контейнера код не
	     падает: EntitlementProbe и ошибки CloudKit дают честное «недоступно». -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.uz.radarmap.ios</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
