            "state": "translated",
            "value": "Baza serveri javob bermadi"
          }
        }
      }
    },
    "Сервер ещё не обновлён — близкий открыл бы ошибку. Попробуйте позже.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ещё не обновлён — близкий открыл бы ошибку. Попробуйте позже."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Server hali yangilanmagan — yaqiningiz xatolikni koʻrardi. Keyinroq urinib koʻring."
          }
        }
      }
    },
    "Сервер карты не отвечает — камеры предупреждают": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер карты не отвечает — камеры предупреждают"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarita serveri javob bermayapti — kameralar ogohlantiradi"
          }
        }
      }
    },
    "Сервер карты не отвечает — карта из скачанной области": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер карты не отвечает — карта из скачанной области"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarita serveri javob bermayapti — xarita yuklab olingan hududdan"
          }
        }
      }
    },
    "Сервер не отвечает — отправлю, как только ответит.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не отвечает — отправлю, как только ответит."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Server javob bermayapti — javob berishi bilan yuboraman."
          }
        }
      }
    },
    "Сервер не отвечает, отправлю позже": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не отвечает, отправлю позже"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Server javob bermayapti, keyinroq yuboraman"
          }
        }
      }
    },
    "Серия поездок подряд, где ни одна камера не поймала бы на штраф.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серия поездок подряд, где ни одна камера не поймала бы на штраф."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birorta kamera jarimaga tutmaydigan ketma-ket safarlar seriyasi."
          }
        }
      }
    },
