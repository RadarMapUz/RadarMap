    },
    "Проезд на красный": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проезд на красный"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qizil chiroqda oʻtish"
          }
        }
      }
    },
    "Проезд снова станет «ожидается», напоминание снимется.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проезд снова станет «ожидается», напоминание снимется."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻtish yana «kutilmoqda» boʻladi, eslatma olib tashlanadi."
          }
        }
      }
    },
    "Проезда в истории нет — сохраним штраф без поездки.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проезда в истории нет — сохраним штраф без поездки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixda oʻtish yoʻq — jarimani safarsiz saqlaymiz."
          }
        }
      }
    },
    "Проездов за период: %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проездов за период: %lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Davr uchun oʻtishlar: %lld"
          }
        }
      }
    },
    "Проездов камер: %1$lld · с превышением: %2$lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проездов камер: %1$lld · с превышением: %2$lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera oʻtishlari: %1$lld · oshirish bilan: %2$lld"
          }
        }
      }
    },
    "Проездов камер: %lld — штрафуемых превышений нет": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проездов камер: %lld — штрафуемых превышений нет"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera oʻtishlari: %lld — jarimali oshirish yoʻq"
          }
        }
      }
    },
    "Проездов со ступенью штрафа: %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проездов со ступенью штрафа: %lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarima pogʻonasiga tushgan oʻtishlar: %lld"
          }
        }
      }
    },
    "Проезды этого дня: %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проезды этого дня: %lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu kungi oʻtishlar: %lld"
          }
        }
      }
    },
    "Проезжайте камеры не выше лимита — уже +6 км/ч попадает в штрафную ступень.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проезжайте камеры не выше лимита — уже +6 км/ч попадает в штрафную ступень."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameralardan limitdan oshmasdan oʻting — +6 km/soat allaqachon jarima pogʻonasi."
          }
        }
      }
    },
    "Проехать столько камер с известным лимитом — без штрафной скорости.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проехать столько камер с известным лимитом — без штрафной скорости."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti maʼlum shuncha kameradan jarima tezligisiz oʻtish."
