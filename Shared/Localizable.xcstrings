    "Фон почти не тратит заряд: точный GPS включается только у камер": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон почти не тратит заряд: точный GPS включается только у камер"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon deyarli quvvat sarflamaydi: aniq GPS faqat kameralar yonida yoqiladi"
          }
        }
      }
    },
    "Хранятся последние %lld поездок. Итоги за месяцы считаются по дневным сводкам — они не удаляются.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся последние %lld поездок. Итоги за месяцы считаются по дневным сводкам — они не удаляются."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi %lld ta safar saqlanadi. Oylik natijalar kunlik hisobotlar bo'yicha hisoblanadi — ular o'chirilmaydi."
          }
        }
      }
    },
    "Чаще всего — %1$@: превышений %2$lld из %3$lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаще всего — %1$@: превышений %2$lld из %3$lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko'pincha — %1$@: %3$lld tadan %2$lld ta oshirish"
          }
        }
      }
    },
    "Чаще всего: %@ — показать": {
      "localizations": {
