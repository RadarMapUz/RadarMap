        }
      }
    },
    "Поездка начнётся сама, когда тронетесь": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Harakatni boshlaganingizda safar oʻzi boshlanadi"
          }
        }
      }
    },
    "Начните поездку кнопкой на экране машины": {
      "localizations": {
