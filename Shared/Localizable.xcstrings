    },
    "Список по каждой камере МВД не публикует — показываем возможности типа": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список по каждой камере МВД не публикует — показываем возможности типа"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "IIV har bir kamera uchun roʻyxat eʼlon qilmaydi — turi imkoniyatlarini koʻrsatamiz"
          }
        }
      }
    },
    "Средние, график по дням, часы риска": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средние, график по дням, часы риска"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻrtacha koʻrsatkichlar, kunlar grafigi, xavf soatlari"
          }
        }
      }
    },
    "Средний балл поездок %@. Длинные поездки весят больше коротких.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний балл поездок %@. Длинные поездки весят больше коротких."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ safarlarning oʻrtacha bali. Uzoq safarlar qisqalaridan koʻproq vazn oladi."
          }
        }
      }
    },
    "Срок": {
      "localizations": {
        "ru": {
