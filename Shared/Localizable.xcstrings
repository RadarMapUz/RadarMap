            "state": "translated",
            "value": "Aloqa yoʻq — paydo boʻlishi bilan yuboraman."
          }
        }
      }
    },
    "Тренога здесь": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренога здесь"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uch oyoq kamera shu yerda"
          }
        }
      }
    },
    "Отмечает треногу в текущей точке — другие водители увидят её на карте.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечает треногу в текущей точке — другие водители увидят её на карте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joriy nuqtada uch oyoq kamerani belgilaydi — boshqa haydovchilar uni xaritada koʻradi."
          }
        }
      }
    },
    "Пост ДПС здесь": {
      "localizations": {
        "ru": {
          "stringUnit": {
