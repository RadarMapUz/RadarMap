        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yashirilgan kamera koʻrinmaydi va ogohlantirmaydi. Uni Sozlamalar → Ilova haqida → Kameralar bazasi → Yashirilgan kameralar boʻlimida qaytarish mumkin."
          }
