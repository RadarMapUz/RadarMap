<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ежедневная копия reports.db с VPS на мак владельца (server/pull_backup.sh).
  11:00 — после ночного бэкапа на сервере (03:17). Если мак спал, launchd
  выполнит пропущенный запуск при пробуждении.

  Установка:
    cp server/uz.radarmap.backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/uz.radarmap.backup.plist
  Проверка: launchctl print gui/$(id -u)/uz.radarmap.backup | grep -E "state|last exit"
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uz.radarmap.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>"$HOME/Zafar/RadarMap/server/pull_backup.sh"</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/zafarbekpolvonboev/Library/Logs/radarmap-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zafarbekpolvonboev/Library/Logs/radarmap-backup.log</string>
</dict>
</plist>
