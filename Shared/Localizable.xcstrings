    "Вывод по вашим %lld проездам: в эту сторону вы каждый раз сбрасываете скорость, во встречную — нет. Это наблюдение, а не данные реестра: предупреждать о камере мы продолжаем в обе стороны.": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вывод по вашему %lld проезду: в эту сторону вы каждый раз сбрасываете скорость, во встречную — нет. Это наблюдение, а не данные реестра: предупреждать о камере мы продолжаем в обе стороны."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вывод по вашим %lld проездам: в эту сторону вы каждый раз сбрасываете скорость, во встречную — нет. Это наблюдение, а не данные реестра: предупреждать о камере мы продолжаем в обе стороны."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вывод по вашим %lld проездам: в эту сторону вы каждый раз сбрасываете скорость, во встречную — нет. Это наблюдение, а не данные реестра: предупреждать о камере мы продолжаем в обе стороны."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вывод по вашим %lld проездам: в эту сторону вы каждый раз сбрасываете скорость, во встречную — нет. Это наблюдение, а не данные реестра: предупреждать о камере мы продолжаем в обе стороны."
                }
              }
            }
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ta oʻtishingiz boʻyicha xulosa: bu tomonga har safar tezlikni pasaytirasiz, qarama-qarshi tomonga — yoʻq. Bu kuzatuv, reyestr maʼlumoti emas: kamera haqida ikkala tomonga ham ogohlantirishda davom etamiz."
          }
        }
      }
    },
    "Выезд на встречную полосу": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выезд на встречную полосу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarama-qarshi yoʻnalishga chiqish"
          }
        }
      }
    },
    "Выезжайте к %1$@ — к %2$@ с запасом (обычно %3$@ в пути)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выезжайте к %1$@ — к %2$@ с запасом (обычно %3$@ в пути)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gacha chiqing — %2$@ ga zaxira bilan (yoʻlda odatda %3$@)"
          }
        }
      }
    },
    "Выключает или возвращает звук и голос оповещений.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключает или возвращает звук и голос оповещений."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogohlantirishlar ovozi va signalini oʻchiradi yoki qaytaradi."
          }
        }
      }
    },
    "Выключение режима прошлые поездки не трогает.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключение режима прошлые поездки не трогает."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejimni oʻchirish oldingi safarlarga taʼsir qilmaydi."
          }
        }
      }
    },
    "Выключенная настройка стирает и то, что приложение выучило.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключенная настройка стирает и то, что приложение выучило."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻchirilgan sozlama ilova oʻrgangan narsalarni ham oʻchiradi."
          }
        }
      }
    },
    "Выключены": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключены"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻchirilgan"
          }
        }
      }
    },
    "Выключите — экран погаснет по таймеру iOS, а о камерах скажет голос.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите — экран погаснет по таймеру iOS, а о камерах скажет голос."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻchirsangiz — ekran iOS taymeri boʻyicha oʻchadi, kameralar haqida ovoz aytadi."
          }
        }
      }
    },
