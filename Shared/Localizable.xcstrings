    "Бензин": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бензин"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzin"
          }
        }
      }
