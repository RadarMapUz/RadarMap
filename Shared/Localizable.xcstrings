            "state": "translated",
            "value": "Ovozni yoqish"
          }
        }
      }
    },
    "Не удалось заехать по пути — маршрут прежний": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось заехать по пути — маршрут прежний"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoʻl-yoʻlakay kirib oʻtib boʻlmadi — marshrut avvalgidek"
          }
        }
      }
    },
    "заезд: %@": {
      "localizations": {
