# Панель модератора. Кладётся в /etc/systemd/system/radarmap-admin.service:
#   systemctl daemon-reload && systemctl enable --now radarmap-admin
#
# Отдельный юнит от radarmap-api намеренно: deploy_api.sh перезапускает api,
# и модерация не должна отваливаться вместе с приёмом репортов от водителей —
# как и наоборот.

[Unit]
Description=RadarMap moderation panel
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/radarmap/api/admin.py
WorkingDirectory=/opt/radarmap/api
# Где лежат ОПУБЛИКОВАННЫЕ тайлы. Без этой строки конструктор открывается, но
# магнит не находит ни одной дороги: путь по умолчанию указывает в каталог,
# которого на сервере нет, — и понять причину неоткуда, потому что дороги в
# тайлах есть, просто панель смотрит не туда.
Environment=RADARMAP_TILES=/opt/radarmap/www/roads
# Панель видна снаружи под этим префиксом (nginx снимает его на входе, а
# ссылки панель подставляет сама).
Environment=RADARMAP_ADMIN_BASE=/radarmap/admin
Restart=always
RestartSec=3

# Панели нужна только своя БД и файл базы камер на чтение.
ProtectSystem=strict
ReadWritePaths=/opt/radarmap/api
ReadOnlyPaths=/opt/radarmap/www
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# Слушает только localhost — наружу отдаёт nginx с basic auth.
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
