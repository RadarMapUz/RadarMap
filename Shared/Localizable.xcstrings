            "state": "translated",
            "value": "Vaqti maʼlum"
          }
        }
      }
    },
    "Время прибытия видят: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время прибытия видят: %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetib kelish vaqtini koʻrmoqda: %@"
          }
        }
      }
    },
    "Время прибытия — тем, кто ждёт: у каждого своя ссылка.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время прибытия — тем, кто ждёт: у каждого своя ссылка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetib kelish vaqti — kutayotganlarga: har kimning oʻz havolasi."
          }
        }
      }
    },
    "Время риска — %1$@: там %2$lld из %3$lld превышений": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время риска — %1$@: там %2$lld из %3$lld превышений"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xavf vaqti — %1$@: %3$lld tadan %2$lld ta oshirish oʻsha payt"
          }
        }
      }
    },
