            "value": "Время прибытия домой — одной постоянной ссылкой."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyga yetib kelish vaqti — bitta doimiy havolada."
          }
        }
      }
    },
