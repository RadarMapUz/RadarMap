        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld marta belgilangan, turli kunlarda: %lld"
          }
        }
      }
    },
    "Отмечать «не пришёл» можно только по сохранённым поездкам — история хранит последние 50.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечать «не пришёл» можно только по сохранённым поездкам — история хранит последние 50."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Kelmadi» belgisini faqat saqlangan safarlarga qo'yish mumkin — tarixda oxirgi 50 tasi saqlanadi."
          }
        }
      }
    },
    "Отмечен водителями, исчезнет ~%@": {
      "localizations": {
