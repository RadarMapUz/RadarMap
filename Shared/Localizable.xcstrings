    "Отмечает треногу в текущей точке — другие водители увидят её на карте.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечает треногу в текущей точке — другие водители увидят её на карте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joriy nuqtada uch oyoq kamerani belgilaydi — boshqa haydovchilar uni xaritada koʻradi."
          }
        }
      }
    },
    "Пост ДПС здесь": {
