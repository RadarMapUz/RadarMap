    "Поиск адреса на ходу недоступен — задайте место, когда машина остановится.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск адреса на ходу недоступен — задайте место, когда машина остановится."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Harakatda manzil qidirib boʻlmaydi — mashina toʻxtaganda joyni belgilang."
          }
        }
      }
    },
