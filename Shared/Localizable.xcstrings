            "state": "translated",
            "value": "Здесь часто ставят треногу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerda tez-tez uchoyoq qo‘yiladi"
          }
        }
      }
    },
