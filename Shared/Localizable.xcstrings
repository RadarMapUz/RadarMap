            "state": "translated",
            "value": "Ваши отметки за 30 дней"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "30 kundagi belgilaringiz"
          }
        }
      }
    },
    "Вашу отметку подтвердили": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу отметку подтвердили"
          }
        },
        "uz": {
