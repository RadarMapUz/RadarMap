        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoʻnalishni qayta tuzyapman"
          }
        }
      }
    },
    "Буду примерно в %1$@ (через %2$@). Следить: %3$@": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxminan %1$@ da yetib boraman (%2$@dan keyin). Kuzatish: %3$@"
          }
        }
      }
    },
    "Поделиться прибытием": {
      "localizations": {
