    "Отрезки пути без устройства и времени — из них считаются пробки.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрезки пути без устройства и времени — из них считаются пробки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qurilma va vaqtsiz yo‘l bo‘laklari — ulardan tirbandlik hisoblanadi."
          }
        }
      }
    },
    "Очистить историю": {
      "localizations": {
